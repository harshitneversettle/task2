generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum Role{
  User 
  Admin
}

model Users {
  id Int @id @default(autoincrement())
  name String 
  email String @unique
  password String
  role  Role @default(User)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
